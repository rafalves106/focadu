<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite `dotnet user-secrets set "Groq:ApiKey" "..."` pra configurar a chave da Groq em
         dev sem tocar em appsettings*.json (ver docs/ARQUITETURA.md). -->
    <UserSecretsId>473fe126-02bd-4bd5-84f8-cedab6abd9fb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Focadu.Domain\Focadu.Domain.csproj" />
    <ProjectReference Include="..\Focadu.Application\Focadu.Application.csproj" />
    <ProjectReference Include="..\Focadu.Infrastructure\Focadu.Infrastructure.csproj" />
  </ItemGroup>

</Project>
