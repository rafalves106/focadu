# Variaveis do docker-compose.yml (producao).
# Copie para `.env` (gitignorado) no host, ao lado do compose file, e ajuste os valores (ver
# convencao de portas em docs/DOCKER.md).

# --- Banco de dados -----------------------------------------------------------------------------
# Producao: DB_NAME=focadu, POSTGRES_PORT=5432 (defaults do compose, pode nem declarar).
DB_NAME=focadu
DB_USER=focadu
DB_PASSWORD=
POSTGRES_PORT=5432

# --- Backend (.NET) ------------------------------------------------------------------------------
# Producao: BACKEND_PORT=5282.
BACKEND_PORT=5282
ASPNETCORE_ENVIRONMENT=Production
# Minimo 32 caracteres - gere com `openssl rand -base64 32`.
JWT_SECRET_KEY=
# Opcionais - app sobe sem eles, so avaliacao por voz/analogias (Groq) e commit de modulo
# (GitHub) ficam degradados.
GROQ_API_KEY=
GITHUB_TOKEN=

# --- Forgejo interno (Projeto Semanal) -------------------------------------------------------------
# Ver secret/rascunhos/repositorios-gerenciados-projeto-semanal.md. Opcional - app sobe sem eles,
# so o provisionamento de repositorio na matricula fica degradado (Weekly fica sem SubmissionUrl).
# Producao: FORGEJO_PORT=3020. Fora da faixa 3000-3002 de proposito -
# ja em uso por outros projetos neste host (ver docs/DOCKER.md).
FORGEJO_PORT=3020
FORGEJO_SSH_PORT=2222
# Endereco INTERNO do container (rede padrao do Compose, nunca muda entre ambientes - so o Admin-
# Token muda). Gerado manualmente apos o 1o boot do Forgejo (criar a conta admin "focadu-admin" via
# UI/CLI, gerar um Personal Access Token com escopo admin - ver docs/DOCKER.md).
FORGEJO_BASE_URL=http://forgejo:3000/api/v1/
FORGEJO_ADMIN_TOKEN=

# Redefinicao de senha (Fase 41) - opcionais, app sobe sem eles, so o email de "esqueci minha
# senha" fica degradado (falha com erro claro se alguem tentar usar o fluxo). Generico via SMTP -
# funciona com Gmail (senha de app, https://myaccount.google.com/apppasswords), Outlook, ou
# qualquer provedor SMTP que voce ja tenha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Focadu
SMTP_ENABLE_SSL=true
# Dominio publico do frontend (ex: https://focadu.seudominio.com) - so usado pra montar o link
# clicavel do email de redefinicao de senha. Vazio em producao = link quebrado apontando pro
# fallback de dev (localhost:5173) - preencha de verdade antes do 1o uso real do fluxo.
FRONTEND_BASE_URL=

# Caminho (no host) do clone de rafalves106/focadu-secret, montado como bind mount read-only no
# container do backend (ver docker-compose.yml). Convencao de pasta:
# producao  -> /Users/falves/Dev/Servidor/focadu/secret
SECRET_PATH=./secret

# --- Frontend (Vite build) -----------------------------------------------------------------------
# Producao: FRONTEND_PORT=5280.
FRONTEND_PORT=5280
# Vazio (default) = o frontend chama caminhos relativos (`/api/...`) e o nginx do proprio
# container faz proxy same-origin pro backend (ver frontend/nginx.conf) - nao precisa de
# subdominio de API separado. So preencha se um dia o backend for exposto num dominio proprio
# (nesse caso vai precisar tambem revisar a allowlist de CORS em backend/src/Focadu.Api/Program.cs,
# hoje fixa em localhost:5173 de dev).
VITE_API_BASE_URL=
