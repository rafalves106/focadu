# Variaveis do docker-compose (producao) e docker-compose.homolog.yml (homologacao).
# Copie para `.env` (gitignorado) no host, ao lado do compose file correspondente, e ajuste os
# valores - os dois ambientes usam o MESMO nome de variavel, so com valores diferentes (ver
# convencao de portas/nomes em README.Docker.md).

# --- Banco de dados -----------------------------------------------------------------------------
# Producao: DB_NAME=focadu, POSTGRES_PORT=5432 (defaults do compose, pode nem declarar).
# Homolog:  DB_NAME=focadu_hml, POSTGRES_PORT=5433 - NUNCA reaproveitar o mesmo valor de producao,
#           os dois ambientes tem volumes Docker separados e nao podem compartilhar dados.
DB_NAME=focadu
DB_USER=focadu
DB_PASSWORD=
POSTGRES_PORT=5432

# --- Backend (.NET) ------------------------------------------------------------------------------
# Producao: BACKEND_PORT=5282. Homolog: BACKEND_PORT=5292.
BACKEND_PORT=5282
ASPNETCORE_ENVIRONMENT=Production
# Minimo 32 caracteres - gere com `openssl rand -base64 32`. Precisa ser DIFERENTE entre
# producao e homologacao (sessoes de um ambiente nao podem validar no outro).
JWT_SECRET_KEY=
# Opcionais - app sobe sem eles, so avaliacao por voz/analogias (Groq) e commit de modulo
# (GitHub) ficam degradados.
GROQ_API_KEY=
GITHUB_TOKEN=

# Caminho (no host) do clone de rafalves106/focadu-secret, montado como bind mount read-only no
# container do backend (ver docker-compose.yml). Convencao de pasta:
# producao  -> C:\Servidor\focadu\secret
# homolog   -> C:\Servidor\focadu-hml\secret
SECRET_PATH=./secret

# --- Frontend (Vite build) -----------------------------------------------------------------------
# Producao: FRONTEND_PORT=5280. Homolog: FRONTEND_PORT=5290.
FRONTEND_PORT=5280
# Vazio (default) = o frontend chama caminhos relativos (`/api/...`) e o nginx do proprio
# container faz proxy same-origin pro backend (ver frontend/nginx.conf) - nao precisa de
# subdominio de API separado. So preencha se um dia o backend for exposto num dominio proprio
# (nesse caso vai precisar tambem revisar a allowlist de CORS em backend/src/Focadu.Api/Program.cs,
# hoje fixa em localhost:5173 de dev).
VITE_API_BASE_URL=
